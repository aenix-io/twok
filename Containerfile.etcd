# syntax=docker/dockerfile:1

# An upstream etcd image with twok in the place of the etcd binary. A
# platform that only lets the etcd image be chosen, Talos with
# cluster.etcd.image or etcd-operator with --etcd-image-repository, runs
# twok without knowing it: twok sees that it was started as etcd, takes its
# own --twok-* flags from the command line and starts the real etcd with the
# rest. With --twok-mode=off it only passes the command line through.
#
# The real etcd binary moves to /usr/local/bin/etcd.real; etcdctl and
# etcdutl stay where they are. The user, the working directory and the
# exposed ports are the upstream image's, so the image behaves like the one
# it replaces.
#
# ETCD_IMAGE is pinned by digest per version in build/etcd.images; the
# default here is the tag alone.

ARG GO_IMAGE=docker.io/library/golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af
ARG ETCD_VERSION
ARG ETCD_IMAGE=gcr.io/etcd-development/etcd:v${ETCD_VERSION}

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd cmd
COPY internal internal
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
      -ldflags "-s -w -X github.com/aenix-io/twok/internal/version.Version=${VERSION}" \
      -o /out/twok ./cmd/twok

FROM ${ETCD_IMAGE} AS etcd

FROM ${ETCD_IMAGE}
ARG ETCD_VERSION
ARG VERSION=dev
LABEL org.opencontainers.image.title="twok-etcd" \
      org.opencontainers.image.description="etcd ${ETCD_VERSION} supervised by twok, which breaks the tie between two members through an external arbiter" \
      org.opencontainers.image.source="https://github.com/aenix-io/twok" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="v${ETCD_VERSION}-twok${VERSION}"
COPY --from=etcd /usr/local/bin/etcd /usr/local/bin/etcd.real
COPY --from=build /out/twok /usr/local/bin/etcd
COPY --from=build /out/twok /usr/local/bin/twok
